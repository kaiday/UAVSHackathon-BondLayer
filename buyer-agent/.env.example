# Optional. Used only for one paragraph of prose after the ranking is already
# decided (D4) -- never for ranking, never for verification. Leave unset (or
# leave the placeholder) and the agent prints a template sentence instead; it
# never raises for a missing key.
OPENAI_API_KEY=sk-your-api-key-here

# Optional. Where the bondlayer merchant service is listening. Defaults to
# http://127.0.0.1:8000, which is where `python run_server.py` binds unless
# that port was busy.
BONDLAYER_MERCHANT_URL=http://127.0.0.1:8000
