# Shared server-side OpenAI configuration. The root .env is preferred; this
# file remains supported for existing installations. Live mode reports API
# failures explicitly rather than substituting a template.
OPENAI_API_KEY=sk-your-api-key-here
BONDLAYER_MODEL=gpt-4o-mini
BONDLAYER_AI_MODE=openai

# Optional. Where the bondlayer merchant service is listening. Defaults to
# http://127.0.0.1:8000, which is where `python run_server.py` binds unless
# that port was busy.
BONDLAYER_MERCHANT_URL=http://127.0.0.1:8000
