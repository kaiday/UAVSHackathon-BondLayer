# BondLayer buyer-agent stand-in (buyer-agent/) for Fly.io. Build context: repo root.
#
# The agent imports bondlayer's own interpreter, valuation and composition code,
# so the bondlayer source tree ships in this image too (on PYTHONPATH, for the
# same reason as Dockerfile.merchant). It is only a library here: this image
# serves no merchant. Point it at the merchant app with BONDLAYER_MERCHANT_URL
# (set in fly.agent.toml).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONPATH=/app/bondlayer/src

WORKDIR /app

COPY bondlayer/requirements.txt bondlayer/requirements.txt
COPY buyer-agent/requirements.txt buyer-agent/requirements.txt
RUN pip install --no-cache-dir -r bondlayer/requirements.txt -r buyer-agent/requirements.txt

COPY bondlayer bondlayer
COPY buyer-agent buyer-agent

RUN useradd --create-home app
USER app

WORKDIR /app/buyer-agent
EXPOSE 8080
CMD ["uvicorn", "src.agent.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
