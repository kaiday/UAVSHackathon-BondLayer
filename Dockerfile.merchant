# BondLayer merchant server (bondlayer/) for Fly.io. Build context: repo root.
#
# The source tree is copied as-is and put on PYTHONPATH rather than
# pip-installed: the server finds data/, keys/, app/dashboard/ and app/out/
# relative to its own source files (Path(__file__).parents[3]), which a
# site-packages install would break.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONPATH=/app/bondlayer/src

WORKDIR /app

COPY bondlayer/requirements.txt bondlayer/requirements.txt
RUN pip install --no-cache-dir -r bondlayer/requirements.txt

COPY bondlayer bondlayer

# Catalogue uploads are written to data/uploads/. On Fly that disk is reset on
# every deploy or restart, which is fine for a prototype.
RUN useradd --create-home app \
    && mkdir -p bondlayer/data/uploads \
    && chown -R app bondlayer/data
USER app

EXPOSE 8080
# uvicorn directly, not run_server.py: that launcher binds 127.0.0.1, which
# Fly's proxy cannot reach.
CMD ["uvicorn", "bondlayer.ucp.server:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
