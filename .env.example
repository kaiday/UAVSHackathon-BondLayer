# Server-side only. Never put these values in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=sk-your-api-key-here
BONDLAYER_MODEL=gpt-4o-mini
BONDLAYER_AI_MODE=openai

# Optional locally; required on both Fly apps, with the same value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BONDLAYER_SERVICE_TOKEN=replace-with-a-generated-secret

# Merchant storage only. The buyer agent submits reports over HTTP.
# Optional: a persistent directory for merchant data, approved records and signing keys.
# BONDLAYER_UPLOADS_DIR=/path/to/merchant-data

# Explicit offline/reference mode: BONDLAYER_AI_MODE=rules.
# Historical synthetic merchants are only loaded when BONDLAYER_TEST_DATA=1.
# Demo: preload every bundled merchant (synthetic + Big W, JB Hi-Fi, Kmart,
# Officeworks); onboarded merchants still load on top.
# BONDLAYER_DEMO_DATA=1
