# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so
# never put a real key here.
#
# A real environment variable always wins over anything in `.env`.

# --- provider key: set ONE of these ---------------------------------------
# With OPENAI_API_KEY set, the demo records against OpenAI (gpt-5 by default).
OPENAI_API_KEY=sk-...

# ANTHROPIC_API_KEY=sk-ant-...
#
# With neither, the demo falls back to the Claude Code CLI if `claude` is on
# PATH and logged in. With none of the three it replays fixtures only.

# --- optional overrides ----------------------------------------------------
# Force a transport: openai | anthropic | claude_cli | off
#   `off` disables live calls entirely, so a stage run replays fixtures and
#   can never hang on the network. Worth setting on the demo machine.
# BONDLAYER_LLM=openai

# Override the model id. Changing this changes the fixture key, so the demo
# will miss its cache and want re-recording -- deliberately, because a fixture
# from a different model is a different experiment.
# BONDLAYER_MODEL=gpt-5

# Read a different env file, or set empty to skip .env loading altogether.
# BONDLAYER_ENV_FILE=
