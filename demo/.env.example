# All keys are OPTIONAL — everything runs offline without them.

# Enables live-agent mode in benchmark.py (otherwise --simulate runs).
ANTHROPIC_API_KEY=
# Model for live benchmark runs (default: claude-sonnet-5).
ANTHROPIC_MODEL=

# Enables the live cross-merchant experiment (compare_llm.py).
OPENAI_API_KEY=
# Model for compare_llm.py (default: gpt-5).
OPENAI_MODEL=

# Stripe TEST key (must start with sk_test_ — live keys are refused).
# Without it, confirm_order simulates a test charge (ch_sim_...).
STRIPE_TEST_KEY=
